# Public URL of this site (used in LINE messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How long to keep the ClinicalTrials.gov snapshot before refreshing (hours)
CACHE_TTL_HOURS=12

# --- AI plain-language Thai explanations (optional) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- LINE alerts (optional) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Basic ID of the LINE Official Account, e.g. @clinicalthai
NEXT_PUBLIC_LINE_OA_ID=

# Secret for /api/cron/notify (send as "Authorization: Bearer <secret>")
CRON_SECRET=

# Where the JSON store for LINE subscriptions lives (default ./.data)
# DATA_DIR=
